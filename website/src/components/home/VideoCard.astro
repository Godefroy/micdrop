---
/**
 * One demo video, with what it shows and where its code lives.
 *
 * With a `videoId`, the card plays it through `Video`, which loads the player
 * only on click. Without one, the card shows a placeholder, so the grid keeps
 * its shape until the video exists.
 */
import Video from '../Video.astro'

interface Props {
  title: string
  description: string
  videoId?: string
  href?: string
  linkLabel?: string
}

const { title, description, videoId, href, linkLabel = 'See the code' } =
  Astro.props

const external = href?.startsWith('http')

// Fixed bar heights for the placeholder, drawn from two sines so the shape
// reads as a voice rather than as noise, and stays the same on every build.
const bars = Array.from({ length: 48 }, (_, i) => {
  const envelope = Math.sin((i / 47) * Math.PI)
  const syllables = 0.55 + 0.45 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6))
  return Math.max(0.08, envelope * syllables)
})
---

<article class="reveal group/video flex flex-col" data-video-card>
  {
    videoId ? (
      <Video videoId={videoId} title={title} bare />
    ) : (
      <div
        class="relative aspect-video overflow-hidden rounded-xl border border-border bg-bg-secondary"
        aria-hidden="true"
        data-media
      >
        <div class="bg-grid absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_80%_70%_at_50%_50%,#000,transparent)]" />
        <div class="absolute top-1/2 left-1/2 flex h-1/3 max-h-24 w-3/4 max-w-md -translate-x-1/2 -translate-y-1/2 items-center justify-between gap-[2px]">
          {bars.map((height, i) => (
            <span
              class="video-bar w-full rounded-full bg-primary"
              style={`height:${(height * 100).toFixed(1)}%;animation-delay:${(i * -97) % 1300}ms`}
            />
          ))}
        </div>
        <span class="absolute bottom-4 left-4 rounded-lg border border-border bg-bg-main/70 px-2.5 py-1 text-xs text-text-secondary backdrop-blur">
          Video coming soon
        </span>
      </div>
    )
  }

  <div class="mt-4 flex flex-col">
    <h3 class="mt-0 mb-1.5 text-lg font-semibold tracking-tight text-text-main">
      {title}
    </h3>
    <p class="mb-0 max-w-[52ch] text-sm leading-relaxed text-text-secondary">
      {description}
    </p>
    {
      href && (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class="mt-3 inline-flex w-fit items-center gap-1.5 text-sm font-medium text-primary no-underline hover:text-primary-light hover:no-underline"
        >
          {linkLabel}
          <span
            aria-hidden="true"
            class="transition-transform duration-300 ease-[var(--ease-rise)] group-hover/video:translate-x-0.5"
          >
            →
          </span>
        </a>
      )
    }
  </div>
</article>

<style>
  /* The placeholder speaks: every bar breathes on its own phase. */
  @media (prefers-reduced-motion: no-preference) {
    .video-bar {
      transform-origin: center;
      animation: video-bar 1.3s ease-in-out infinite alternate;
      opacity: 0.55;
    }
  }
  @keyframes video-bar {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
