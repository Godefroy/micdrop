---
/**
 * The four surfaces Micdrop runs on, as four tabs named like the files they
 * would live in: React, React Native, the browser without a framework, and
 * the Node server. React comes first since most readers start there. Every panel is rendered at build time and the
 * script only changes which one is visible, so the code is highlighted server
 * side and readable without JavaScript.
 *
 * The panels are stacked in a single grid cell rather than shown one at a
 * time, so the card is always as tall as its tallest snippet and switching
 * tabs moves nothing on the page.
 */
// The same highlighter as the documentation, so both use one theme and one
// configuration (see `ec.config.mjs`). `frame="none"` drops the chrome, since
// these snippets sit inside the card below.
import { Code } from 'astro-expressive-code/components'

const panels = [
  {
    id: 'react',
    label: 'react-client.tsx',
    install: 'npm install @micdrop/web @micdrop/react',
    lang: 'tsx',
    code: `import { Micdrop } from '@micdrop/web'
import { useMicdropState } from '@micdrop/react'

const start = () => Micdrop.start({ url: 'wss://your-server.com' })

function Call() {
  const { isStarted, conversation } = useMicdropState()
  return (
    <>
      <button onClick={isStarted ? Micdrop.stop : start}>
        {isStarted ? 'Hang up' : 'Start the call'}
      </button>
      {conversation.map((item, i) =>
        'content' in item && (
          <p key={i}>{item.role}: {item.content}</p>
        )
      )}
    </>
  )
}`,
  },
  {
    id: 'native',
    label: 'react-native-client.tsx',
    install: 'npm install @micdrop/react-native @micdrop/react react-native-audio-api',
    lang: 'tsx',
    code: `import { Micdrop } from '@micdrop/react-native'
import { useMicdropState } from '@micdrop/react'
import { Button, Text, View } from 'react-native'

const start = () => Micdrop.start({ url: 'wss://your-server.com' })

function Call() {
  const { isStarted, conversation } = useMicdropState()
  return (
    <View>
      <Button
        title={isStarted ? 'Hang up' : 'Start the call'}
        onPress={isStarted ? Micdrop.stop : start}
      />
      {conversation.map((item, i) =>
        'content' in item && (
          <Text key={i}>{item.role}: {item.content}</Text>
        )
      )}
    </View>
  )
}`,
  },
  {
    id: 'web',
    label: 'client.ts',
    install: 'npm install @micdrop/web',
    lang: 'typescript',
    code: `import { Micdrop } from '@micdrop/web'

Micdrop.start({ url: 'wss://your-server.com' })

Micdrop.on('StateChange', (state) => {
  console.log(state.conversation)
  console.log(state.isAssistantSpeaking)
})

Micdrop.on('EndCall', () => {
  console.log('Call ended by assistant')
})

// Hang up
Micdrop.stop()`,
  },
  {
    id: 'server',
    label: 'server.ts',
    install:
      'npm install @micdrop/server @micdrop/openai @micdrop/gladia @micdrop/elevenlabs',
    lang: 'typescript',
    code: `import { MicdropServer } from '@micdrop/server'
import { OpenaiAgent } from '@micdrop/openai'
import { GladiaSTT } from '@micdrop/gladia'
import { ElevenLabsTTS } from '@micdrop/elevenlabs'

const { OPENAI_KEY, GLADIA_KEY, TTS_KEY, VOICE } =
  process.env as Record<string, string>
const systemPrompt = 'You are a helpful assistant'

wss.on('connection', (socket) => {
  new MicdropServer(socket, {
    firstMessage: 'How can I help you today?',
    agent: new OpenaiAgent({ apiKey: OPENAI_KEY, systemPrompt }),
    stt: new GladiaSTT({ apiKey: GLADIA_KEY }),
    tts: new ElevenLabsTTS({ apiKey: TTS_KEY, voiceId: VOICE }),
  })
})`,
  },
]

const tabBase =
  'cursor-pointer border-b-2 px-3.5 py-2 text-[13px] font-medium whitespace-nowrap transition-colors'
const tabOn = 'border-primary text-text-main'
const tabOff = 'border-transparent text-text-secondary hover:text-text-main'
---

<div
  class="overflow-hidden rounded-xl border border-border bg-bg-secondary"
  data-home-code
>
  <div
    class="flex overflow-x-auto border-b border-border bg-bg-elevated"
    role="tablist"
    aria-label="Micdrop quick start"
  >
    {
      panels.map((panel, index) => (
        <button
          type="button"
          role="tab"
          id={`home-code-tab-${panel.id}`}
          aria-controls={`home-code-panel-${panel.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-tab={panel.id}
          class:list={[tabBase, index === 0 ? tabOn : tabOff]}
        >
          {panel.label}
        </button>
      ))
    }
  </div>

  <div class="grid">
    {
      panels.map((panel, index) => (
        <div
          class:list={[
            // `min-w-0` keeps a long line inside the card: without it the grid
            // item grows to its content and the code is clipped rather than
            // scrolled.
            'col-start-1 row-start-1 flex min-w-0 flex-col',
            index > 0 && 'invisible',
          ]}
          role="tabpanel"
          id={`home-code-panel-${panel.id}`}
          aria-labelledby={`home-code-tab-${panel.id}`}
          data-panel={panel.id}
        >
          {/* The install command is one line of shell, not a sample worth a
              frame of its own: it sits on a strip under the tabs. It wraps
              between packages, and the lines after the first are indented
              so the command still reads as one. */}
          <div class="border-b border-border py-2.5 pr-5 pl-[calc(1.25rem+2ch)] -indent-[2ch] font-mono text-sm text-text-secondary">
            {/* Each word on one line, so a package name never breaks on its
                hyphen. */}
            {panel.install.split(' ').map((word, i) => (
              <>
                {i > 0 && ' '}
                <span class="whitespace-nowrap">{word}</span>
              </>
            ))}
          </div>
          {/* Long lines wrap rather than scroll, keeping their indentation
              plus two more columns, so a continued line reads as one. */}
          <div class="min-w-0 px-5 py-3.5">
            <Code
              code={panel.code}
              lang={panel.lang}
              frame="none"
              wrap
              preserveIndent
              hangingIndent={2}
            />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /**
   * The snippet is the panel, not a block sitting inside it: it drops its
   * frame, its rounding and its own padding, so the code starts on the same
   * left edge as the install command above it and the two read as one column.
   * Spacing comes from the wrapper. The snippets are cut to the shape of the
   * call rather than to a working file, which is what lets the type stay large
   * enough to read from a distance without the card pushing the hero down.
   */
  [data-home-code] {
    --ec-codeFontSize: 0.875rem;
    --ec-codeLineHt: 1.45;
    --ec-codePadBlk: 0;
    /* With a unit: Expressive Code adds it to lengths inside calc(), where a
       bare 0 voids the whole padding that holds a wrapped line's hanging
       indent, and every line then loses its first columns. */
    --ec-codePadInl: 0px;
    --ec-brdWd: 0px;
    --ec-brdRad: 0px;
    --ec-codeBg: transparent;
  }
  [data-home-code] :global(.expressive-code) {
    margin: 0;
    text-align: left;
  }
  /**
   * The frame keeps a drop shadow of its own, which draws the edge of a panel
   * that is no longer there. Set on the element rather than through
   * `--ec-frm-frameBoxShdCssVal`: the light theme redefines that variable at a
   * higher specificity than this block, so the override only held in the dark
   * one and the shadow came back under the light palette.
   */
  [data-home-code] :global(.expressive-code .frame) {
    box-shadow: none;
  }
</style>

<script>
  const root = document.querySelector('[data-home-code]')

  if (root) {
    const on = ['border-primary', 'text-text-main']
    const off = ['border-transparent', 'text-text-secondary', 'hover:text-text-main']

    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]')
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]')

    const showTab = (name: string) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.tab === name
        tab.setAttribute('aria-selected', String(selected))
        // Only the selected tab is in the tab order; the arrow keys move
        // between them, as expected of a tablist.
        tab.tabIndex = selected ? 0 : -1
        tab.classList.remove(...on, ...off)
        tab.classList.add(...(selected ? on : off))
      })
      // The panels share one grid cell, so hiding is a visibility change: the
      // card keeps the height of its tallest snippet whichever tab is open.
      panels.forEach((panel) => {
        panel.classList.toggle('invisible', panel.dataset.panel !== name)
      })
    }

    function handleTabClick(event: MouseEvent) {
      showTab((event.currentTarget as HTMLElement).dataset.tab!)
    }

    function handleTabKeyDown(event: KeyboardEvent) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
      event.preventDefault()
      const list = Array.from(tabs)
      const from = list.indexOf(event.currentTarget as HTMLButtonElement)
      const step = event.key === 'ArrowRight' ? 1 : -1
      const next = list[(from + step + list.length) % list.length]
      showTab(next.dataset.tab!)
      next.focus()
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', handleTabClick)
      tab.addEventListener('keydown', handleTabKeyDown)
    })
  }
</script>
