---
/**
 * One exchange of a voice call, played on a timeline, with what Micdrop does
 * at each moment of it. It replaces the box diagram of the pipeline: a reader
 * learns more from watching a hesitation survive and an interruption land
 * than from arrows between STT, agent and TTS.
 *
 * The MDX passes two kinds of children:
 *   - `TurnLine` in the `lines` slot, the speech of each side, placed on the
 *     timeline by percentage;
 *   - `TurnStep` in the default slot, the annotations, each one pinned to the
 *     moment it describes with `at`.
 *
 * Geometry: the steps draw their marker on the rail above the lanes, from far
 * down the DOM. They are positioned against this panel, so the panel is the
 * only positioned ancestor between them and the rail, and the CSS variables
 * below describe where the lanes sit inside it.
 *
 * Motion: a script marks the panel `data-playing` and moves `--p` from 0 to 1
 * while it is on screen. The lines and the steps read it to light up as the
 * playhead reaches them. Under `prefers-reduced-motion`, or without
 * JavaScript, the exchange is shown complete, with no playhead.
 */
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro?: string
  userLabel?: string
  assistantLabel?: string
}

const {
  title,
  intro,
  userLabel = 'You',
  assistantLabel = 'Assistant',
} = Astro.props
---

<HomeSection title={title} intro={intro} band>
  <div
    class="turn reveal relative rounded-xl border border-border bg-bg-main p-[var(--pad)] [counter-reset:turn-step]"
    data-turn
  >
    {/* The rail the step markers sit on. */}
    <div class="h-[var(--rail)]" aria-hidden="true"></div>

    <div
      class="grid grid-cols-[var(--label)_minmax(0,1fr)] grid-rows-[var(--lane)_var(--lane)] gap-y-[var(--gap)]"
      aria-hidden="true"
    >
      <div class="flex items-center text-xs font-medium text-text-secondary sm:text-sm">
        {userLabel}
      </div>
      <div class="relative col-start-2 row-span-2 row-start-1" data-lanes>
        <div class="absolute inset-x-0 top-1/2 border-t border-dashed border-border"></div>
        <slot name="lines" />
        <div class="turn-playhead pointer-events-none absolute inset-y-[-0.75rem] left-0 w-full">
          <span class="absolute inset-y-0 right-0 w-px bg-primary shadow-[0_0_12px_2px_rgb(16_185_129/0.45)]"></span>
        </div>
      </div>
      <div class="row-start-2 flex items-center text-xs font-medium text-text-secondary sm:text-sm">
        {assistantLabel}
      </div>
    </div>

    <ol
      class="mt-10 mb-0 grid list-none grid-cols-1 gap-x-6 gap-y-7 border-t border-border p-0 pt-8 sm:grid-cols-2 lg:grid-cols-5"
    >
      <slot />
    </ol>
  </div>
</HomeSection>

<style>
  .turn {
    --pad: 1.25rem;
    --label: 4.5rem;
    --rail: 2rem;
    --lane: 3.5rem;
    --gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .turn {
      --pad: 2rem;
      --label: 6.5rem;
      --lane: 4.5rem;
    }
  }

  /* The playhead is a full-width layer whose right edge is the line, slid
     by its own width, so the move is a transform the compositor handles. */
  .turn-playhead {
    display: none;
    transform: translateX(calc((var(--p) - 1) * 100%));
    opacity: var(--playhead, 1);
    transition: opacity 0.4s;
  }
  [data-playing] .turn-playhead {
    display: block;
  }
</style>

<script>
  const DURATION = 15000
  const HOLD = 2200

  /** Lights what the playhead has reached, from one progress value. */
  function render(root: HTMLElement, p: number) {
    root.style.setProperty('--p', p.toFixed(4))
    root.querySelectorAll<HTMLElement>('[data-line]').forEach((line) => {
      const from = Number(line.dataset.from) / 100
      const to = Number(line.dataset.to) / 100
      const local = Math.min(1, Math.max(0, (p - from) / (to - from)))
      line.style.setProperty('--lp', local.toFixed(4))
      line.toggleAttribute('data-started', local > 0)
    })
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((step) => {
      step.toggleAttribute('data-reached', p >= Number(step.dataset.at) / 100)
    })
  }

  function play(root: HTMLElement) {
    // Until this attribute is set, the styles show the exchange complete,
    // which is also what a reader without JavaScript gets.
    root.toggleAttribute('data-playing', true)
    let frame = 0
    let start = 0
    let running = false

    function tick(now: number) {
      if (!start) start = now
      const elapsed = (now - start) % (DURATION + HOLD)
      const p = Math.min(1, elapsed / DURATION)
      // The line fades during the hold, so the jump back to the start reads
      // as a new take rather than a glitch.
      root.style.setProperty('--playhead', elapsed > DURATION ? '0' : '1')
      render(root, p)
      frame = requestAnimationFrame(tick)
    }

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !running) {
        running = true
        start = 0
        frame = requestAnimationFrame(tick)
      } else if (!entry.isIntersecting && running) {
        running = false
        cancelAnimationFrame(frame)
      }
    })
    observer.observe(root)
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll<HTMLElement>('[data-turn]').forEach((root) => {
    if (!reduced) play(root)
  })
</script>

