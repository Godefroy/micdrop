---
/**
 * Open Graph and Twitter card tags. Receives the already-resolved page title
 * and description from `BaseLayout` so the social preview always mirrors the
 * `<title>` and `<meta name="description">` of the page.
 */
import config from '../../website.config'

interface Props {
  title: string
  description?: string
  image?: ImageMetadata
  /** `article` on blog posts, `website` everywhere else. */
  type?: 'website' | 'article'
  url: string
  lang?: string
}

const { title, description, image, type = 'website', url, lang = 'en' } = Astro.props
const imageUrl = image ? new URL(image.src, Astro.site).href : undefined
---

<meta property="og:site_name" content={config.siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={lang} />
<meta name="twitter:title" content={title} />
{
  description && (
    <>
      <meta property="og:description" content={description} />
      <meta name="twitter:description" content={description} />
    </>
  )
}
{
  imageUrl ? (
    <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content={String(image!.width)} />
      <meta property="og:image:height" content={String(image!.height)} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={imageUrl} />
    </>
  ) : (
    <meta name="twitter:card" content="summary" />
  )
}
