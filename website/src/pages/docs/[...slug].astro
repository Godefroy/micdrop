---
/**
 * Every documentation page. The file path inside `src/content/docs` is the URL,
 * and the loader already folds `client/index.mdx` into the id `client`.
 */
import { getCollection, render } from 'astro:content'
import DocPage from '../../layouts/DocPage.astro'
import { mdxComponents } from '../../components'
import { docHref, flattenDocs, getDocsTree } from '../../utils/docs-tree'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  // Reading order of the sidebar, so the previous / next links follow the
  // sequence a reader going through the docs would take.
  const order = flattenDocs(await getDocsTree())

  return entries.map((entry) => {
    const position = order.findIndex((link) => link.href === docHref(entry.id))

    return {
      params: { slug: entry.id || undefined },
      props: {
        entry,
        previous: position > 0 ? order[position - 1] : undefined,
        next: position === -1 ? undefined : order[position + 1],
      },
    }
  })
}

const { entry, previous, next } = Astro.props
const { Content, headings } = await render(entry)
---

<DocPage
  title={entry.data.title}
  titleBrand={entry.data.titleBrand}
  description={entry.data.description}
  headings={headings}
  previous={previous}
  next={next}
  lang={entry.data.lang}
>
  <Content components={mdxComponents} />
</DocPage>
