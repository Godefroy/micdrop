---
import type { MarkdownHeading } from 'astro'
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'

interface Props {
  title: string
  /** Appends ` | <brand>` to the document title. */
  titleBrand?: boolean
  description?: string
  headings: MarkdownHeading[]
  lang?: 'en' | 'fr'
}

const { title, titleBrand = true, description, headings, lang } = Astro.props
---

<BaseLayout title={title} titleBrand={titleBrand} description={description} bottomSpace={false} fullWidth lang={lang}>
  <div class="flex min-h-[calc(100dvh-3.5rem)] w-full">
    <Sidebar />
    <div class="min-w-0 max-w-5xl flex-1 px-6 py-8 md:px-12">
      <slot />
    </div>
    <Toc headings={headings} />
  </div>
</BaseLayout>
