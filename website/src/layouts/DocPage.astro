---
import type { MarkdownHeading } from 'astro'
import DocsLayout from './DocsLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import DocNav from '../components/DocNav.astro'
import { getDocsTrail, getDocsTree, type DocsLink } from '../utils/docs-tree'
import { getCanonicalPath } from '../utils/getCanonicalPath'

interface Props {
  title: string
  /** Appends ` | <brand>` to the document title. */
  titleBrand?: boolean
  description?: string
  headings: MarkdownHeading[]
  previous?: DocsLink
  next?: DocsLink
  lang?: 'en' | 'fr'
}

const { title, titleBrand = true, description, headings, previous, next, lang } = Astro.props

// The groups the page sits under, so the breadcrumb mirrors the sidebar.
const sections = getDocsTrail(await getDocsTree(), getCanonicalPath(Astro.url.pathname))
---

<DocsLayout title={title} titleBrand={titleBrand} description={description} headings={headings} lang={lang}>
  <article>
    <header class="mb-8">
      <Breadcrumb
        category="Documentation"
        categoryUrl="/docs/getting-started"
        sections={sections}
        title={title}
        hideTitle
        class="mb-3"
      />
      <h1 class="mt-0 text-4xl font-bold">{title}</h1>
    </header>
    <div>
      <slot />
    </div>
    <DocNav previous={previous} next={next} />
  </article>
</DocsLayout>
