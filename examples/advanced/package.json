{
  "name": "@micdrop/advanced",
  "version": "1.0.0",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only -P tsconfig.server.json server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "@micdrop/ai-sdk": "*",
    "@micdrop/cartesia": "*",
    "@micdrop/elevenlabs": "*",
    "@micdrop/gemini": "*",
    "@micdrop/gladia": "*",
    "@micdrop/gradium": "*",
    "@micdrop/kokoro": "*",
    "@micdrop/mistral": "*",
    "@micdrop/openai": "*",
    "@micdrop/phonon": "*",
    "@micdrop/piper": "*",
    "@micdrop/pocket-tts": "*",
    "@micdrop/qwen-tts": "*",
    "@micdrop/react": "*",
    "@micdrop/server": "*",
    "@micdrop/smart-turn": "*",
    "@micdrop/web": "*",
    "@micdrop/whisper": "*",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.7",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.19.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
