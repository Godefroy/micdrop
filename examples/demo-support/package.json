{
  "name": "@micdrop/demo-support",
  "version": "1.0.0",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only -P tsconfig.server.json src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@micdrop/openai": "*",
    "@micdrop/react": "*",
    "@micdrop/server": "*",
    "@micdrop/typesafe": "*",
    "@micdrop/web": "*",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.19.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
