{
  "name": "@micdrop/demo-robot",
  "version": "1.0.0",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only -P tsconfig.server.json src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "measure": "ts-node-dev --transpile-only -P tsconfig.server.json src/server/measure.ts",
    "measure:classifiers": "ts-node-dev --transpile-only -P tsconfig.server.json src/server/measure-classifiers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/websocket": "^11.3.4",
    "@micdrop/gemini": "*",
    "@micdrop/openai": "*",
    "@micdrop/react": "*",
    "@micdrop/server": "*",
    "@micdrop/typesafe": "*",
    "@micdrop/web": "*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "camera-controls": "^3.1.2",
    "dotenv": "^17.0.0",
    "fastify": "^5.12.7",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.19.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
