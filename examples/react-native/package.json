{
  "name": "@micdrop/react-native-example",
  "version": "1.0.0",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"pnpm dev:server\" \"pnpm dev:app\"",
    "dev:server": "tsx watch --env-file=server/.env server/src/server.ts",
    "dev:app": "expo start --dev-client --port 8086",
    "ios": "expo run:ios --port 8086",
    "android": "expo run:android --port 8086",
    "prebuild": "expo prebuild",
    "bundle": "expo export --platform ios --output-dir .expo-export",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@micdrop/react": "*",
    "@micdrop/react-native": "*",
    "@micdrop/smart-turn": "*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-audio-api": "^0.13.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@micdrop/openai": "*",
    "@micdrop/server": "*",
    "@types/node": "^22.19.13",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "react-dom": "19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
  }
}
