    "@micdrop/server": "*",
    "@types/node": "^22.19.13",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
