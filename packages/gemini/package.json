  "dependencies": {
    "@google/genai": "^2.22.0",
    "eventemitter3": "^5",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "@micdrop/server": ">=2.8.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
