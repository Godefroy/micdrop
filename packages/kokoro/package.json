{
  "name": "@micdrop/kokoro",
  "version": "1.1.0",
  "description": "Local Kokoro text to speech for @micdrop/server",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godefroy/micdrop.git",
    "directory": "packages/kokoro"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "microphone",
    "audio",
    "voice",
    "conversation",
    "kokoro",
    "local",
    "offline",
    "tts"
  ],
  "dependencies": {
    "kokoro-js": "^1.2.1"
  },
  "peerDependencies": {
    "@micdrop/server": ">=2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
