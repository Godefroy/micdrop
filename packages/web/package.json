{
  "name": "@micdrop/web",
  "version": "1.3.0",
  "description": "🖐️🎤 Micdrop: real-time voice conversations with AI, in the browser",
  "author": "Godefroy de Compreignac",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godefroy/micdrop.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "microphone",
    "audio",
    "browser",
    "voice",
    "conversation"
  ],
  "dependencies": {
    "@micdrop/client": "^3.4.0",
    "onnxruntime-web": "^1.23.2"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "esbuild-raw-plugin": "^0.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./silero": {
      "types": "./dist/silero.d.ts",
      "import": "./dist/silero.mjs",
      "require": "./dist/silero.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    }
  }
}
